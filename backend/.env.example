# Databento historical API key (tick + candle data)
DATABENTO_API_KEY=

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=journal
DB_PASS=journal
DB_NAME=journal

# API port
PORT=8090

# Timezone the imported NinjaTrader fill times are recorded in
TRADE_TZ=Australia/Sydney

# Path to the `claude` CLI used for AI analysis
CLAUDE_PATH=claude
